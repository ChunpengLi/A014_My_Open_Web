{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a014-my-open-web",
  "main": "src/worker.js",
  "compatibility_date": "2025-12-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "ANTHROPIC_BASE_URL": "https://hyueapi.com",
    "AI_MODEL": "claude-sonnet-4-5-20250929",
    "AI_MAX_TOKENS": "2048"
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "a014-my-open-web-uploads"
    }
  ]
}
