{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a014-my-open-web",
  "main": "src/worker.js",
  "compatibility_date": "2025-12-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "a014-my-open-web-uploads"
    }
  ]
}
